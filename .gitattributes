*.sh text eol=lf
Makefile text eol=lf

# The host patches are checksum-verified before they are applied, so their
# bytes must survive checkout unchanged. Without this, core.autocrlf=true
# rewrites them to CRLF on Windows and the SHA256 gate fails.
*.patch -text whitespace=-blank-at-eol

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
