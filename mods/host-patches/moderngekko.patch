--- /dev/null
+++ b/tests/colosseum_text_upscale_test.cpp
@@ -0,0 +1,48 @@
+#include "VideoCommon/ColosseumTextUpscale.h"
+
+#include <cmath>
+
+int main()
+{
+  const auto enabled = ColosseumTextUpscale::GetPlan(true, true, false, 512, 512, 1, 0);
+  if (!enabled.enabled || enabled.width != 2048 || enabled.height != 2048 ||
+      enabled.filter != ColosseumTextUpscale::Filter::Coverage)
+    return 1;
+
+  if (ColosseumTextUpscale::GetPlan(false, true, false, 512, 512, 1, 0).enabled)
+    return 2;
+  if (ColosseumTextUpscale::GetPlan(true, false, false, 512, 512, 1, 0).enabled)
+    return 3;
+  if (ColosseumTextUpscale::GetPlan(true, true, false, 256, 512, 1, 0).enabled)
+    return 4;
+  if (ColosseumTextUpscale::GetPlan(true, true, false, 512, 512, 2, 0).enabled)
+    return 5;
+
+  const auto battle_hud = ColosseumTextUpscale::GetPlan(
+      true, false, true, 256, 239, 1, ColosseumTextUpscale::BATTLE_STATUS_ATLAS_HASH);
+  if (!battle_hud.enabled || battle_hud.width != 1024 || battle_hud.height != 956 ||
+      battle_hud.filter != ColosseumTextUpscale::Filter::ColorCoverage)
+    return 10;
+  if (ColosseumTextUpscale::GetPlan(true, false, true, 256, 239, 1, 0).enabled)
+    return 11;
+  if (ColosseumTextUpscale::GetPlan(true, false, false, 256, 239, 1,
+                                    ColosseumTextUpscale::BATTLE_STATUS_ATLAS_HASH)
+          .enabled)
+    return 12;
+
+  // The coverage pass must preserve transparent counters inside glyphs while tightening both
+  // sides of their contours. This guards against dilation-style sharpening that fills O/P/B/8.
+  if (ColosseumTextUpscale::SharpenCoverage(0.0f) != 0.0f ||
+      ColosseumTextUpscale::SharpenCoverage(1.0f) != 1.0f)
+    return 6;
+  if (ColosseumTextUpscale::SharpenCoverage(0.1f) != 0.0f ||
+      ColosseumTextUpscale::SharpenCoverage(0.9f) != 1.0f)
+    return 7;
+  if (ColosseumTextUpscale::SharpenCoverage(0.34f) != 0.0f ||
+      ColosseumTextUpscale::SharpenCoverage(0.66f) != 1.0f)
+    return 8;
+  if (std::abs(ColosseumTextUpscale::SharpenCoverage(0.5f) - 0.5f) > 0.0001f)
+    return 9;
+
+  return 0;
+}
