+        (cpu)->ps1[(d)] = dolrecomp_rounded;                                   \
+    } while (0)
+
+#define DOLRECOMP_DEFINE_FP_FAST(suffix, WRITE_SINGLE)                         \
+    static inline void ppc_fadds##suffix(CPUState* cpu, u8 d, u8 a, u8 b) {    \
