+    }                                                                          \
+    static inline void ppc_fsubs##suffix(CPUState* cpu, u8 d, u8 a, u8 b) {    \
+        const f64 result = cpu->fpr[a] - cpu->fpr[b];                          \
+        if (dolrecomp_fp_ordinary(result)) {                                   \
+            WRITE_SINGLE(cpu, d, result);                                      \
+            return;                                                            \
+        }                                                                      \
+        ppc_fsubs(cpu, d, a, b);                                               \
+    }                                                                          \
