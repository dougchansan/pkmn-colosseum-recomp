diff --git a/Source/Core/VideoCommon/ColosseumTextUpscale.h b/Source/Core/VideoCommon/ColosseumTextUpscale.h
new file mode 100644
index 0000000000..41e779e627
--- /dev/null
+++ b/Source/Core/VideoCommon/ColosseumTextUpscale.h
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstdint>
+
+namespace ColosseumTextUpscale
+{
+// A 0.30-wide transition is approximately one antialiased output pixel at 4x magnification.
+// The previous 0.60-wide ramp left two to three soft pixels around every glyph contour.
+constexpr float COVERAGE_LOW = 0.35f;
+constexpr float COVERAGE_HIGH = 0.65f;
+constexpr float COLOR_COVERAGE_LOW = 0.22f;
+constexpr float COLOR_COVERAGE_HIGH = 0.78f;
+
+// Battle status labels (Lv/HP/EXP) and their neighboring HUD sprites share this RGB5A3 atlas.
+// Keying the color-preserving path by both dimensions and hash keeps the text option from
+// sharpening unrelated scene textures that happen to use the same format.
+constexpr std::uint64_t BATTLE_STATUS_ATLAS_HASH = 0x592cd77b475e4a80ULL;
+
+enum class Filter
+{
+  None,
+  Coverage,
+  ColorCoverage,
+};
+
+constexpr float SharpenCoverage(float coverage)
+{
+  if (coverage <= COVERAGE_LOW)
+    return 0.0f;
+  if (coverage >= COVERAGE_HIGH)
+    return 1.0f;
+
+  const float t = (coverage - COVERAGE_LOW) / (COVERAGE_HIGH - COVERAGE_LOW);
+  return t * t * (3.0f - 2.0f * t);
+}
+
+struct Plan
+{
+  bool enabled = false;
+  std::uint32_t width = 0;
+  std::uint32_t height = 0;
+  Filter filter = Filter::None;
+};
+
+constexpr Plan GetPlan(bool enabled, bool is_i4, bool is_rgb5a3, std::uint32_t width,
+                       std::uint32_t height, std::uint32_t level_count,
+                       std::uint64_t texture_hash)
+{
+  constexpr std::uint32_t scale = 4;
+  if (!enabled || level_count != 1)
+    return {};
+
+  if (is_i4 && width == 512 && height == 512)
+  {
+    return {.enabled = true,
+            .width = width * scale,
+            .height = height * scale,
+            .filter = Filter::Coverage};
+  }
+
+  if (is_rgb5a3 && width == 256 && height == 239 &&
+      texture_hash == BATTLE_STATUS_ATLAS_HASH)
+  {
+    return {.enabled = true,
+            .width = width * scale,
+            .height = height * scale,
+            .filter = Filter::ColorCoverage};
+  }
+
+  return {};
+}
+}  // namespace ColosseumTextUpscale
